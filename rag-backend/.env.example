# Database
DATABASE_URL=postgresql+psycopg://raguser:ragpass@localhost:5435/ragdb

# OpenAI (Embedding)
OPENAI_API_KEY=sk-...
OPENAI_EMBED_MODEL=text-embedding-3-small
OPENAI_EMBED_DIM=1536

# Anthropic (Generation)
ANTHROPIC_API_KEY=sk-ant-...
ANTHROPIC_MODEL=claude-sonnet-4-6

# Hybrid sparse retrieval (P2b: dense + zh sparse fused with RRF)
# Sparse retrieval requires BOTH the custom `trace-rag/pg-zhparser` Postgres
# image (see deploy/postgres-zhparser/) AND alembic migration 004_p2b_sparse.
# Set ENABLE_SPARSE=false to degrade to dense-only on stock pgvector/pgvector
# images or databases that haven't run migration 004.
ENABLE_SPARSE=true
SPARSE_CANDIDATE_K=20
RRF_K=10
RRF_DENSE_WEIGHT=0.5
RRF_SPARSE_WEIGHT=0.5

# Cohere Rerank (optional; empty = pure cosine)
COHERE_API_KEY=
COHERE_RERANK_MODEL=rerank-multilingual-v3.0

# Storage
UPLOAD_DIR=./uploads

# Aliyun OCR (optional; empty = OCR disabled, scanned pages dropped)
ALIYUN_OCR_ACCESS_KEY_ID=
ALIYUN_OCR_ACCESS_KEY_SECRET=
ALIYUN_OCR_ENDPOINT=ocr-api.cn-hangzhou.aliyuncs.com

# App
LOG_LEVEL=INFO
