# Database
DATABASE_URL=postgresql+psycopg://raguser:ragpass@localhost:5435/ragdb

# OpenAI (Embedding)
OPENAI_API_KEY=sk-...
OPENAI_EMBED_MODEL=text-embedding-3-small
OPENAI_EMBED_DIM=1536

# Anthropic (Generation)
ANTHROPIC_API_KEY=sk-ant-...
ANTHROPIC_MODEL=claude-sonnet-4-6

# Cohere Rerank (optional; empty = pure cosine)
COHERE_API_KEY=
COHERE_RERANK_MODEL=rerank-multilingual-v3.0

# Storage
UPLOAD_DIR=./uploads

# Aliyun OCR (optional; empty = OCR disabled, scanned pages dropped)
ALIYUN_OCR_ACCESS_KEY_ID=
ALIYUN_OCR_ACCESS_KEY_SECRET=
ALIYUN_OCR_ENDPOINT=ocr-api.cn-hangzhou.aliyuncs.com

# App
LOG_LEVEL=INFO
