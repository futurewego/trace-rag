# Copy to /opt/rag/.env on the server, fill in real values, chmod 600
# Generate AUTH_PASSWORD_HASH with:
#   docker run --rm caddy:2-alpine caddy hash-password --plaintext 'YOUR_PASSWORD'

DOMAIN=app.yourdomain.com
ADMIN_EMAIL=you@example.com

AUTH_USER=demo
# Single-quote the hash so $ in bcrypt is not interpreted by shell:
AUTH_PASSWORD_HASH='$2a$14$REPLACE_WITH_OUTPUT_OF_HASH_COMMAND'

PG_PASSWORD=replace-with-strong-password
OPENAI_API_KEY=sk-...
ANTHROPIC_API_KEY=sk-ant-...
OPENAI_EMBED_MODEL=text-embedding-3-small
OPENAI_EMBED_DIM=1536
ANTHROPIC_MODEL=claude-sonnet-4-6
